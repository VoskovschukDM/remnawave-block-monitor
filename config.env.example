# Main loop
CHECK_INTERVAL_SECONDS=600
CHECK_JITTER_SECONDS=30
MAX_CONCURRENT_TARGETS=3

# Targets
DEFAULT_PORT=443
DOMAIN_CHECK_MODE=tcp,http
TARGETS_FILE=/etc/remnawave-block-monitor/targets.txt

# Debounce
FAILURES_BEFORE_ALERT=3
RECOVERIES_BEFORE_ALERT=2
STATE_FILE=/var/lib/remnawave-block-monitor/state.json

# Check-Host (official JSON API)
CHECKHOST_ENABLED=true
CHECKHOST_BASE_URL=https://check-host.net
CHECKHOST_RU_COUNTRIES=RU
CHECKHOST_CONTROL_COUNTRIES=DE,NL,FI,PL
CHECKHOST_RU_NODE_COUNT=3
CHECKHOST_CONTROL_NODE_COUNT=3
CHECKHOST_RU_NODES=
CHECKHOST_CONTROL_NODES=
CHECKHOST_TIMEOUT=15
CHECKHOST_RESULT_TIMEOUT=30
CHECKHOST_POLL_INTERVAL=1.5
CHECKHOST_REQUEST_DELAY=0.5

# CheburCheck
CHEBURCHECK_ENABLED=true
CHEBURCHECK_BASE_URL=https://cheburcheck.ru/api/v1
CHEBURCHECK_TIMEOUT=15
CHEBURCHECK_REQUEST_DELAY=2.2

# Shared transient-error retry count (429, 5xx, DNS and timeout)
HTTP_RETRY_ATTEMPTS=3

# Telegram Bot API sendMessage (getUpdates is never used)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=15

LOG_LEVEL=INFO
